#!/bin/sh
# claude-Utube: lệnh quản lý xưởng phim.
#   sh bin/studio setup                 đưa thư viện về đúng phiên bản trong library.lock, báo công cụ còn thiếu
#   sh bin/studio status [--json]       trạng thái xưởng (không dùng mạng, không ghi file)
#   sh bin/studio deps [voice] [music]  cài gói của thư viện (Node, Python, giọng, nhạc) vào lib/lemo-opuscar
#   sh bin/studio deps learn [--extra]  cài công cụ học phong cách vào tools/.venv (--extra: tải video, chép lời)
#   sh bin/studio learn <lệnh> …        học phong cách: fetch | measure | transcribe | summary | check-names | compare | save | clean
#   sh bin/studio deps ui               cài giao diện web (tools/.venv)
#   sh bin/studio deps online           cài thêm gói cho chế độ online (specs/007)
#   sh bin/studio admin create <email>  tạo tài khoản quản trị (chế độ online: STUDIO_MODE=online, STUDIO_DATA)
#   sh bin/studio ui [open|status|stop] mở / xem / tắt giao diện; job … · review …: sổ việc và duyệt (xem specs/003)
#   sh bin/studio help
# Mã thoát: 0 = sẵn sàng / xong · 1 = chưa sẵn sàng / thất bại · 2 = sai cách dùng hoặc library.lock sai.
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
LIB_REL=lib/lemo-opuscar
LIB="$ROOT/$LIB_REL"
TMP="$ROOT/lib/.lemo-opuscar.tmp"
# Bỏ demo, gallery và ảnh lớn; giữ poster của từng phong cách (giao diện Library, 004)
SPARSE='/*
!/styles/*/demo/
!/styleboard/
!/docs/frames/
!/docs/cover.jpg
!/docs/opuscar98.jpg'
# Lần cài đầu chưa lấy poster, để lỗi tải poster không làm hỏng thư viện (poster lấy ở bước sau)
SPARSE_BASE="$SPARSE
!/styles/*/poster.jpg"

usage() {
  sed -n '2,11s/^# \{0,1\}//p' "$0"
}

die2() { echo "✗ $*" >&2; exit 2; }

# ---------- library.lock ----------
read_lock() {
  LIB_REPO=''; LIB_COMMIT=''
  if [ -f "$ROOT/library.lock" ]; then
    LIB_REPO=$(tr -d '\r' < "$ROOT/library.lock" | sed -n 's/^LIB_REPO=//p' | head -n 1)
    LIB_COMMIT=$(tr -d '\r' < "$ROOT/library.lock" | sed -n 's/^LIB_COMMIT=//p' | head -n 1)
  fi
  LIB_REPO=${STUDIO_LIB_REPO:-$LIB_REPO}
  LIB_COMMIT=${STUDIO_LIB_COMMIT:-$LIB_COMMIT}
  [ -n "$LIB_REPO" ] || die2 "library.lock thiếu LIB_REPO"
  case $LIB_COMMIT in
    '' | *[!0-9a-f]*) die2 "library.lock: LIB_COMMIT phải là SHA 40 ký tự hex (đang là \"$LIB_COMMIT\")" ;;
  esac
  [ ${#LIB_COMMIT} -eq 40 ] || die2 "library.lock: LIB_COMMIT phải đúng 40 ký tự (đang có ${#LIB_COMMIT})"
}

# ---------- công cụ ----------
# Lấy MAJOR.MINOR đầu tiên trong một dòng; rỗng nếu không có
ver_of() {
  printf '%s\n' "$1" | sed -n 's/[^0-9]*\([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1.\2/p' | head -n 1
}
# ver_ge FOUND MIN: đúng nếu FOUND >= MIN (so MAJOR rồi MINOR)
ver_ge() {
  f1=${1%%.*}; f2=${1#*.}; if [ "$f2" = "$1" ]; then f2=0; fi
  m1=${2%%.*}; m2=${2#*.}; if [ "$m2" = "$2" ]; then m2=0; fi
  if [ "$f1" -gt "$m1" ]; then return 0; fi
  if [ "$f1" -lt "$m1" ]; then return 1; fi
  [ "$f2" -ge "$m2" ]
}
# Dòng đầu của "<lệnh> <đối số>", rỗng nếu lệnh không có
vline() {
  if command -v "$1" >/dev/null 2>&1; then "$@" 2>&1 | head -n 1 || true; fi
}
add_tool() {  # name found min state hint
  TOOLS="${TOOLS}$1|$2|$3|$4|$5
"
  case $4 in missing | old) TOOLS_BAD=$((TOOLS_BAD + 1)) ;; esac
}
probe() {  # name min line hint
  if [ -z "$3" ]; then add_tool "$1" '' "$2" missing "$4"; return 0; fi
  pv=$(ver_of "$3")
  if [ -z "$pv" ]; then add_tool "$1" '' "$2" unknown "không đọc được phiên bản (\"$3\"); cần ≥ $2"
  elif ver_ge "$pv" "$2"; then add_tool "$1" "$pv" "$2" ok ''
  else add_tool "$1" "$pv" "$2" old "$4"; fi
}
check_tools() {
  TOOLS=''; TOOLS_BAD=0
  probe git 2.25 "$(vline git --version)" "cài hoặc nâng cấp git: https://git-scm.com/downloads"
  probe node 20 "$(vline node --version)" "cài Node 20+: https://nodejs.org"
  probe ffmpeg 7 "$(vline ffmpeg -version)" "cài ffmpeg 7+ (Ubuntu 24.04 chỉ có 6.1, dùng bản static: https://johnvansickle.com/ffmpeg/)"
  pl=$(vline python3 --version); pyv=$(ver_of "$pl")
  if command -v uv >/dev/null 2>&1 && { [ -z "$pyv" ] || ! ver_ge "$pyv" 3.11; }; then
    add_tool python "$pyv" 3.11 ok "dùng uv (uv tự tải Python phù hợp)"
  else
    probe python 3.11 "$pl" "cài Python 3.11+ hoặc uv: https://docs.astral.sh/uv/"
  fi
  check_browser
}
# Thư viện hệ thống mà trình duyệt chạy ngầm (chụp khung, render phim) cần trên Ubuntu 24.04 / WSL
APT_BROWSER_LIBS='libnss3 libnspr4 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2t64'
# Chỉ trên Linux và chỉ khi đã cài gói của thư viện (sh bin/studio deps): trình duyệt có chạy được không
check_browser() {
  [ "$(uname -s 2>/dev/null)" = Linux ] || return 0
  [ -d "$LIB/node_modules/playwright-core" ] || return 0
  exe=${PLAYWRIGHT_CHROME:-}
  if [ -z "$exe" ]; then
    base=${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}
    for f in "$base"/chromium_headless_shell-*/chrome-*/headless_shell "$base"/chromium_headless_shell-*/chrome-*/chrome-headless-shell; do
      if [ -x "$f" ]; then exe=$f; fi
    done
  fi
  if [ -z "$exe" ] || [ ! -x "$exe" ]; then
    add_tool browser '' libs missing "chưa có trình duyệt chạy ngầm: sh bin/studio deps"; return 0
  fi
  command -v ldd >/dev/null 2>&1 || return 0
  miss=$(ldd "$exe" 2>/dev/null | awk '/not found/ {print $1}' | tr '\n' ' ')
  if [ -n "$miss" ]; then
    add_tool browser '' libs missing "thiếu thư viện hệ thống: ${miss}→ Ubuntu/WSL: sudo apt-get install -y $APT_BROWSER_LIBS"
  else
    add_tool browser ok libs ok ''
  fi
}
state_label() {
  case $1 in
    ok) echo 'có' ;; missing) echo 'thiếu' ;; old) echo 'quá cũ' ;; unknown) echo 'không rõ' ;;
  esac
}
print_tools() {
  echo "Công cụ hệ thống:"
  printf '%s' "$TOOLS" | while IFS='|' read -r n f m s h; do
    case $s in ok) mk='✓' ;; unknown) mk='?' ;; *) mk='✗' ;; esac
    if [ "$n" = browser ]; then need='đủ thư viện'; else need="≥ $m"; fi
    printf '  %s %-7s %-8s cần %-7s %s\n' "$mk" "$n" "${f:--}" "$need" "$(state_label "$s")"
    if [ -n "$h" ]; then printf '      → %s\n' "$h"; fi
  done
}

# ---------- thư viện ----------
# LSTATE: missing | foreign | modified | outdated | ok ; LIB_FOUND = commit hiện tại
lib_state() {
  LIB_FOUND=''; MODIFIED=''
  if [ ! -d "$LIB" ] || [ -z "$(ls -A "$LIB" 2>/dev/null)" ]; then LSTATE=missing; return 0; fi
  # Phải là repo riêng (không để git leo lên repo của dự án) và do xưởng quản lý
  if [ ! -d "$LIB/.git" ] || [ "$(git -C "$LIB" config --get studio.managed 2>/dev/null || true)" != true ]; then
    LSTATE=foreign; return 0
  fi
  LIB_FOUND=$(git -C "$LIB" rev-parse HEAD 2>/dev/null || true)
  # npm install của thư viện có thể ghi lại package-lock.json: không coi là sửa
  MODIFIED=$(git -C "$LIB" status --porcelain --untracked-files=no 2>/dev/null | grep -v ' package-lock.json$' || true)
  if [ -n "$MODIFIED" ]; then LSTATE=modified
  elif [ "$LIB_FOUND" != "$LIB_COMMIT" ]; then LSTATE=outdated
  else LSTATE=ok; fi
}
# fetch_commit DIR: lấy LIB_COMMIT về DIR và checkout (detached)
fetch_commit() {
  if ! git -C "$1" fetch --quiet --depth 1 origin "$LIB_COMMIT" 2>"$1/.git/studio-fetch.log"; then
    # Máy chủ không cho fetch theo SHA: lấy đủ lịch sử rồi tìm commit
    if [ -f "$1/.git/shallow" ]; then
      git -C "$1" fetch --quiet --unshallow origin 2>>"$1/.git/studio-fetch.log" || return 1
    else
      git -C "$1" fetch --quiet origin 2>>"$1/.git/studio-fetch.log" || return 1
    fi
  fi
  git -C "$1" cat-file -e "$LIB_COMMIT^{commit}" 2>/dev/null || { echo "commit $LIB_COMMIT không có trên $LIB_REPO" >>"$1/.git/studio-fetch.log"; return 1; }
  git -C "$1" -c advice.detachedHead=false checkout --quiet --detach "$LIB_COMMIT" 2>>"$1/.git/studio-fetch.log"
}
install_fresh() {
  rm -rf "$TMP"
  mkdir -p "$TMP"
  trap 'rm -rf "$TMP"' INT TERM
  git -C "$TMP" init --quiet
  git -C "$TMP" remote add origin "$LIB_REPO"
  git -C "$TMP" config studio.managed true      # KHÔNG đặt lemo.managed: setup.sh của thư viện sẽ reset về main
  # Tải từng phần: chỉ lấy file cần cho phần sparse (máy chủ không hỗ trợ thì tải đủ, vẫn đúng)
  git -C "$TMP" config remote.origin.promisor true
  git -C "$TMP" config remote.origin.partialclonefilter blob:none
  git -C "$TMP" config core.sparseCheckout true
  git -C "$TMP" config core.sparseCheckoutCone false
  printf '%s\n' "$SPARSE_BASE" > "$TMP/.git/info/sparse-checkout"
  if fetch_commit "$TMP"; then
    trap - INT TERM
    if [ -d "$LIB" ]; then rmdir "$LIB"; fi      # chỉ khi rỗng (trạng thái missing)
    mv "$TMP" "$LIB"
    return 0
  fi
  echo "✗ tải thư viện thất bại (mất mạng, hoặc LIB_REPO / LIB_COMMIT sai):" >&2
  sed 's/^/    /' "$TMP/.git/studio-fetch.log" >&2 || true
  rm -rf "$TMP"
  trap - INT TERM
  return 1
}
short() { printf '%.7s' "$1"; }
# get_posters: thêm poster vào bản sao thư viện (đổi danh sách sparse, không sửa file thư viện).
# Lỗi → trả lại danh sách cũ để lần setup sau thử lại; không đổi mã thoát của setup.
get_posters() {
  sp="$LIB/.git/info/sparse-checkout"
  have=$(count_posters "$LIB/styles"); total=$(count_styles "$LIB/styles")
  if [ "$(cat "$sp" 2>/dev/null)" = "$SPARSE" ] && [ "$have" -ge "$total" ]; then
    echo "✓ poster: $have/$total"; return 0
  fi                      # list changed, or still missing posters (e.g. an earlier setup was interrupted)
  echo "↓ đang tải poster của phong cách…"
  old=$(cat "$sp" 2>/dev/null || true)
  printf '%s\n' "$SPARSE" > "$sp"
  if git -C "$LIB" sparse-checkout reapply >"$LIB/.git/studio-posters.log" 2>&1; then
    echo "✓ đã có poster: $(count_posters "$LIB/styles")/$(count_styles "$LIB/styles")"
  else
    printf '%s\n' "$old" > "$sp"
    echo "✗ poster chưa tải được (mất mạng?). Làm phim vẫn được; chạy lại: sh bin/studio setup"
  fi
}

# ---------- đếm ----------
count_styles() {  # thư mục con có STYLE.md, trừ _template
  n=0
  for d in "$1"/*/; do
    [ -f "${d}STYLE.md" ] || continue
    case $(basename "$d") in _template) continue ;; esac
    n=$((n + 1))
  done
  echo "$n"
}
count_posters() {  # phong cách (trừ _template) có poster.jpg
  n=0
  for d in "$1"/*/; do
    [ -f "${d}STYLE.md" ] && [ -f "${d}poster.jpg" ] || continue
    case $(basename "$d") in _template) continue ;; esac
    n=$((n + 1))
  done
  echo "$n"
}
count_dirs() {
  n=0
  for d in "$1"/*/; do if [ -d "$d" ]; then n=$((n + 1)); fi; done
  echo "$n"
}
json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# ---------- lệnh ----------
cmd_setup() {
  read_lock
  check_tools
  print_tools
  echo
  if ! command -v git >/dev/null 2>&1; then
    echo "✗ cần git để tải thư viện."; exit 1
  fi
  rc=0
  lib_state
  case $LSTATE in
    missing)
      echo "↓ đang tải thư viện vào $LIB_REL (phiên bản $(short "$LIB_COMMIT"))…"
      if install_fresh; then echo "✓ đã tải thư viện."; else rc=1; fi ;;
    outdated)
      echo "↻ cập nhật thư viện từ $(short "$LIB_FOUND") lên $(short "$LIB_COMMIT")…"
      if fetch_commit "$LIB"; then echo "✓ đã cập nhật thư viện."
      else echo "✗ cập nhật thất bại:"; sed 's/^/    /' "$LIB/.git/studio-fetch.log"; rc=1; fi ;;
    ok)
      echo "✓ thư viện đã đúng phiên bản $(short "$LIB_COMMIT"), không cần tải." ;;
    foreign)
      echo "✗ $LIB_REL có nội dung nhưng không phải thư viện do xưởng quản lý. Không xoá gì."
      echo "  → đổi tên hoặc xoá thư mục đó, rồi chạy lại: sh bin/studio setup"
      rc=1 ;;
    modified)
      echo "✗ thư viện có thay đổi cục bộ, không ghi đè:"
      printf '%s\n' "$MODIFIED" | sed 's/^/    /'
      echo "  → thư viện phải giữ nguyên (hiến pháp VI). Bỏ thay đổi: git -C $LIB_REL checkout -- ."
      rc=1 ;;
  esac
  lib_state
  if [ "$LSTATE" = ok ]; then get_posters; fi
  echo
  if [ "$LSTATE" = ok ] && [ "$TOOLS_BAD" -eq 0 ] && [ "$rc" -eq 0 ]; then
    echo "✓ xưởng sẵn sàng. Gói của thư viện cài khi phim cần: sh bin/studio deps [voice] [music]"
  else
    [ "$LSTATE" = ok ] || rc=1
    if [ "$TOOLS_BAD" -gt 0 ]; then echo "✗ còn $TOOLS_BAD công cụ thiếu hoặc quá cũ (xem → ở trên). Xưởng không tự cài phần mềm hệ thống."; rc=1; fi
    echo "✗ xưởng chưa sẵn sàng."
  fi
  exit "$rc"
}

cmd_status() {
  json=0
  for a in "$@"; do
    case $a in --json) json=1 ;; *) echo "✗ không hiểu \"$a\"" >&2; usage >&2; exit 2 ;; esac
  done
  read_lock
  check_tools
  if command -v git >/dev/null 2>&1; then lib_state; else LSTATE=missing; LIB_FOUND=''; fi
  if [ "$LSTATE" = missing ] || [ "$LSTATE" = foreign ]; then n_lib=0; n_post=0
  else n_lib=$(count_styles "$LIB/styles"); n_post=$(count_posters "$LIB/styles"); fi
  n_my=$(count_styles "$ROOT/my-styles")
  n_films=$(count_dirs "$ROOT/films")
  deps=false
  if [ -d "$LIB/node_modules" ] && [ -d "$LIB/.venv" ]; then deps=true; fi
  ready=false
  if [ "$LSTATE" = ok ] && [ "$TOOLS_BAD" -eq 0 ]; then ready=true; fi

  if [ "$json" -eq 1 ]; then
    printf '{"ready":%s,"library":{"path":%s,"state":%s,"commit_expected":%s,"commit_found":%s},"tools":[' \
      "$ready" "$(json_str "$LIB_REL")" "$(json_str "$LSTATE")" "$(json_str "$LIB_COMMIT")" "$(json_str "$LIB_FOUND")"
    printf '%s' "$TOOLS" | {
      sep=''
      while IFS='|' read -r n f m s h; do
        printf '%s{"name":%s,"found":%s,"min":%s,"state":%s,"hint":%s}' "$sep" \
          "$(json_str "$n")" "$(json_str "$f")" "$(json_str "$m")" "$(json_str "$s")" "$(json_str "$h")"
        sep=','
      done
    }
    printf '],"counts":{"library_styles":%s,"library_posters":%s,"my_styles":%s,"films":%s},"deps_core":%s}\n' "$n_lib" "$n_post" "$n_my" "$n_films" "$deps"
  else
    echo "Xưởng: $ROOT"
    case $LSTATE in
      ok) echo "  ✓ thư viện   $LIB_REL @ $(short "$LIB_FOUND") (đúng phiên bản)" ;;
      missing) echo "  ✗ thư viện   chưa có → sh bin/studio setup" ;;
      outdated) echo "  ✗ thư viện   $(short "$LIB_FOUND"), cần $(short "$LIB_COMMIT") → sh bin/studio setup" ;;
      modified) echo "  ✗ thư viện   có thay đổi cục bộ → git -C $LIB_REL checkout -- ." ;;
      foreign) echo "  ✗ thư viện   $LIB_REL không phải thư viện do xưởng quản lý" ;;
    esac
    print_tools
    echo "  Phong cách thư viện: $n_lib · poster: $n_post/$n_lib · phong cách riêng: $n_my · phim: $n_films"
    if [ "$deps" = true ]; then echo "  Gói lõi của thư viện: đã cài"; else echo "  Gói lõi của thư viện: chưa cài (cần khi làm phim) → sh bin/studio deps"; fi
    if [ "$ready" = true ]; then echo "✓ sẵn sàng"; else echo "✗ chưa sẵn sàng"; fi
  fi
  if [ "$ready" = true ]; then exit 0; else exit 1; fi
}

VENV="$ROOT/tools/.venv"

# Python ≥ 3.11 để tạo venv khi không có uv
find_py() {
  for c in python3.12 python3.13 python3.11 python3; do
    if "$c" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then echo "$c"; return 0; fi
  done
  return 1
}

deps_learn() {
  extra=0
  for a in "$@"; do
    case $a in --extra) extra=1 ;; *) echo "✗ không hiểu \"$a\" (dùng: deps learn [--extra])" >&2; exit 2 ;; esac
  done
  if [ "$extra" -eq 1 ]; then deps_tiers learn learn-extra; else deps_tiers learn; fi
}

# Cài các tầng tools/requirements-<tầng>.txt vào venv riêng của xưởng
deps_tiers() {
  # Venv riêng của xưởng: không cài gì vào lib/ (hiến pháp VI)
  if [ ! -x "$VENV/bin/python" ] || ! "$VENV/bin/python" -c pass 2>/dev/null; then
    rm -rf "$VENV"
    if command -v uv >/dev/null 2>&1; then uv venv --quiet --python 3.12 "$VENV"
    else
      py=$(find_py) || { echo "✗ cần Python 3.11+ (hoặc cài uv: https://docs.astral.sh/uv/)" >&2; exit 1; }
      "$py" -m venv "$VENV"
    fi
  fi
  for t in "$@"; do
    req="$ROOT/tools/requirements-$t.txt"
    sig="$(cksum < "$req" | cut -d' ' -f1)-$("$VENV/bin/python" -V 2>&1)"
    if [ "$(cat "$VENV/.studio-$t" 2>/dev/null || true)" = "$sig" ]; then echo "✓ $t đã cài"; continue; fi
    echo "↓ cài $t…"
    if command -v uv >/dev/null 2>&1; then uv pip install --quiet --python "$VENV/bin/python" -r "$req"
    else "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check -r "$req"; fi
    printf '%s\n' "$sig" > "$VENV/.studio-$t"
    echo "✓ đã cài $t"
  done
}

# Lệnh của giao diện và sổ việc (tools/studio): ui · job · review
cmd_studio() {
  if [ ! -x "$VENV/bin/python" ] || ! "$VENV/bin/python" -c 'import fastapi, uvicorn' 2>/dev/null; then
    echo "✗ chưa cài giao diện. Chạy: sh bin/studio deps ui" >&2; exit 1
  fi
  STUDIO_ROOT="$ROOT" exec "$VENV/bin/python" "$ROOT/tools/studio/studio_cli.py" "$@"
}

cmd_learn() {
  if [ ! -x "$VENV/bin/python" ]; then
    echo "✗ chưa cài công cụ học phong cách. Chạy: sh bin/studio deps learn" >&2; exit 1
  fi
  exec "$VENV/bin/python" "$ROOT/tools/style-learn/learn.py" "$@"
}

cmd_deps() {
  if [ "${1:-}" = learn ]; then shift; deps_learn "$@"; return 0; fi
  if [ "${1:-}" = ui ]; then deps_tiers ui; return 0; fi
  if [ "${1:-}" = online ]; then deps_tiers ui online; return 0; fi
  read_lock
  lib_state
  if [ "$LSTATE" != ok ]; then
    echo "✗ thư viện chưa sẵn sàng ($LSTATE). Chạy trước: sh bin/studio setup" >&2; exit 1
  fi
  # Đặt LEMO_OPUSCAR_HOME, nếu không trình cài của thư viện sẽ tải một bản khác vào ~/lemo-opuscar
  LEMO_OPUSCAR_HOME="$LIB" exec sh "$LIB/plugin/skills/lemo-opuscar/scripts/setup.sh" deps "$@"
}

case ${1:-} in
  setup) shift; cmd_setup "$@" ;;
  status) shift; cmd_status "$@" ;;
  deps) shift; cmd_deps "$@" ;;
  learn) shift; cmd_learn "$@" ;;
  ui | job | review | admin) cmd_studio "$@" ;;
  help | -h | --help) usage ;;
  '') usage >&2; exit 2 ;;
  *) echo "✗ lệnh lạ: $1" >&2; usage >&2; exit 2 ;;
esac
