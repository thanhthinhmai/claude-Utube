{
  "name": "claude-utube-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell of the claude-Utube studio (specs/015): Windows (core in WSL2) and macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test test/*.test.js",
    "pack:win": "electron-builder --win --publish never",
    "pack:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "author": "claude-Utube"
}
