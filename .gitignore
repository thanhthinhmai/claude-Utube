node_modules/
dist/
.env
.env.*
.DS_Store
*.tmp
*.swp

# Style library (fetched by `sh bin/studio setup`, pinned in library.lock)
lib/

# Films and reference videos stay on this machine only
films/*
!films/README.md
references/*
!references/README.md

# Media files are never committed
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.m4a

# Style-learning tools venv
tools/.venv/
__pycache__/
*.pyc

# Studio UI runtime state (jobs, reviews, server pid)
.studio/

# Online mode (specs/007): secrets and server data
deploy/.env
/data/
tests/online/.tmp/
!deploy/.env.example
tests/filmcheck/.tmp/
channels/*/topics.json
channels/*/TOPICS.md
channels/*/references.json

# License server (specs/017): secrets and the build-time server address
deploy/license/.env
desktop/build-config.json

# Demo films of learned styles are rebuilt by demo/build.sh, not committed (specs/021 R7)
my-styles/*/test.mp4

# Real-person library: model sheets carry third-party reference photos (specs/028 R2)
people/*/.sheet/

# Sound per shot (specs/037): the sound library lives in $STUDIO_DATA/sound, never here.
# films/*/sound/cache, films/*/sound/stems and references/*/stems are already covered by films/* and references/*.
sound-library/
