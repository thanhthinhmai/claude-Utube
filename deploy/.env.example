# Copy to deploy/.env (never commit that file) and fill in. Used by: sh bin/studio online up
DOMAIN=studio.example.com
# absolute folder on this server for accounts, films and the database; must be writable by uid 1000
STUDIO_DATA_HOST=/srv/studio/data
# optional: used only when no Claude account (signed in on AI accounts) can take a call (specs/008)
ANTHROPIC_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Film Studio <noreply@studio.example.com>
# CPU and memory of one job container
STUDIO_JOB_CPUS=4
STUDIO_JOB_MEMORY=8g
# The job agent compacts its conversation at this many tokens, and keeps Bash output over this many characters
# in a file instead of the conversation (specs/030). Empty = 300000 and 20000.
STUDIO_AUTO_COMPACT_WINDOW=
STUDIO_BASH_MAX_OUTPUT=
