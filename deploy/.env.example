# Copy to deploy/.env (never commit that file) and fill in. Used by: sh bin/studio online up
DOMAIN=studio.example.com
# absolute folder on this server for accounts, films and the database; must be writable by uid 1000
STUDIO_DATA_HOST=/srv/studio/data
ANTHROPIC_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Film Studio <noreply@studio.example.com>
# CPU and memory of one job container
STUDIO_JOB_CPUS=4
STUDIO_JOB_MEMORY=8g
