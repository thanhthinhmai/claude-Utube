#!/usr/bin/env python3
"""A fake Claude Code for tests (specs/008 T003). Mirrors what T001 saw on the real one:
- `auth login --claudeai` prints the URL wrapped in a terminal hyperlink (OSC 8), then waits for the code on stdin;
- `auth status --json` exits 1 with loggedIn false when signed out.
Fields of a signed-in status follow research R1 until T001 checks them on a real account.

Codes: `good-<email>` signs in (plan from FAKE_CLAUDE_PLAN, default max); anything else is refused.
FAKE_CLAUDE_REFRESH=fail makes refreshing an expiring token fail. FAKE_CLAUDE_SLEEP=<s> delays every command."""
import json
import os
import sys
import time

CFG = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
CRED = os.path.join(CFG, ".credentials.json")
URL = "https://claude.com/cai/oauth/authorize?code=true&client_id=fake&state=s1"


def load():
    try:
        with open(CRED) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save(d):
    os.makedirs(CFG, exist_ok=True)
    with open(CRED, "w") as f:
        json.dump(d, f)


def token(email, n):
    return f"tok-{email}-{n}"


def editor(prompt):
    """The script editor of specs/010 (T007). Tags in a `>` note line of SCRIPT.md choose the answer:
    [editor-pass] (default) score 9; [editor-p1 Pnn] a P1 on Pnn until that paragraph changes; [editor-low] score 6
    every round; [editor-bad-json] an answer without a score."""
    import re
    m = re.search(r"^- (.+/SCRIPT\.md)$", prompt, re.M)      # paths may have spaces
    script = open(m.group(1), encoding="utf-8").read() if m else ""
    out = {"score": 9, "issues": [], "checked_sources": []}
    p1 = re.search(r"\[editor-p1 (P\d+)\]", script)
    if "[editor-bad-json]" in script:
        out = {"issues": "not a list"}
    elif "[editor-low]" in script:
        out = {"score": 6, "issues": [{"level": "P2", "para": "P01", "reason": "the opening is flat"}], "checked_sources": []}
    elif p1:
        para = p1.group(1)
        text = (re.search(rf"^\[{para}\](.*)$", script, re.M) or [None, ""])[1].strip()
        state = os.path.join(os.path.dirname(m.group(1)), ".check", "fake-editor.json")
        os.makedirs(os.path.dirname(state), exist_ok=True)
        first = json.load(open(state)) if os.path.exists(state) else {}
        first.setdefault(para, text)
        json.dump(first, open(state, "w"))
        if first[para] == text:
            out = {"score": 8, "issues": [{"level": "P1", "para": para, "reason": "this number does not match its source"}],
                   "checked_sources": [{"url": "https://example.org/hanoi-motorbikes", "matches": False}]}
    if m:                         # the arguments it got, next to the script (online tests read them there)
        os.makedirs(os.path.join(os.path.dirname(m.group(1)), ".check"), exist_ok=True)
        json.dump(sys.argv[1:], open(os.path.join(os.path.dirname(m.group(1)), ".check", "editor-args.json"), "w"))
    base, tok = os.environ.get("ANTHROPIC_BASE_URL"), os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")
    if base and tok:              # like the real editor: its calls go through the studio's proxy (specs/010 FR-016)
        import urllib.request
        body = json.dumps({"model": "claude-opus-5-5", "max_tokens": 16, "messages": [{"role": "user", "content": "review"}]})
        req = urllib.request.Request(base.rstrip("/") + "/v1/messages", data=body.encode(), method="POST",
                                     headers={"authorization": "Bearer " + tok, "content-type": "application/json",
                                              "anthropic-version": "2023-06-01", "anthropic-beta": "oauth-2025-04-20"})
        try:
            urllib.request.urlopen(req, timeout=30).read()
        except Exception as e:    # noqa: BLE001
            print(f"fake editor: proxy call failed: {e}", file=sys.stderr)
    print(json.dumps({"type": "result", "is_error": False, "structured_output": out,
                      "usage": {"input_tokens": 1200, "output_tokens": 300}}))
    return 0


def topics(prompt):
    """The channel-fit judge of specs/013: fit 7 for each topic, 2 with [fit-low]; two suggestions when asked."""
    import re
    block = prompt.split("Topics:", 1)[-1].split("\n\n", 1)[0]
    names = [ln[2:].strip() for ln in block.splitlines() if ln.startswith("- ")]
    fit = [{"topic": t, "score": 2 if "[fit-low]" in t else 7, "type": "comparison" if re.search(r"\bvs\b", t) else "explainer",
            "reason": "fits the channel" if "[fit-low]" not in t else "off the channel's niche"} for t in names]
    sug = ["how bees make honey", "honey in old medicine"] if "Also suggest" in prompt else []
    print(json.dumps({"type": "result", "is_error": False, "structured_output": {"fit": fit, "suggested": sug},
                      "usage": {"input_tokens": 400, "output_tokens": 120}}))
    return 0


def main(argv):
    if os.environ.get("FAKE_CLAUDE_SLEEP"):
        time.sleep(float(os.environ["FAKE_CLAUDE_SLEEP"]))
    if argv[:2] == ["auth", "login"]:
        print(f"Opening browser to sign in…\nIf the browser didn't open, visit: \x1b]8;;{URL}\x07{URL}\x1b]8;;\x07",
              flush=True)
        print("Paste code here if prompted > ", end="", flush=True)
        code = sys.stdin.readline().strip()
        if not code.startswith("good-"):
            print("\nLogin failed: That code wasn't accepted. Please try again.", flush=True)
            return 1
        email = code[5:]
        save({"claudeAiOauth": {"accessToken": token(email, 1), "refreshToken": f"refresh-{email}",
                                "expiresAt": int((time.time() + 8 * 3600) * 1000), "n": 1,
                                "subscriptionType": os.environ.get("FAKE_CLAUDE_PLAN", "max"), "email": email}})
        print("\nLogin successful.", flush=True)
        return 0
    if argv[:2] == ["auth", "status"]:
        d = load()
        if not d:
            print(json.dumps({"loggedIn": False, "authMethod": "none", "apiProvider": "firstParty",
                              "configDirectory": CFG, "loginExpiresAt": None}))
            return 1
        o = d["claudeAiOauth"]
        if o["expiresAt"] / 1000 - time.time() < 600:          # expiring: refresh like the real one does
            if os.environ.get("FAKE_CLAUDE_REFRESH") == "fail":
                print(json.dumps({"loggedIn": False, "authMethod": "none", "error": "refresh failed"}))
                return 1
            o["n"] += 1
            o["accessToken"] = token(o["email"], o["n"])
            o["expiresAt"] = int((time.time() + 8 * 3600) * 1000)
            save(d)
        print(json.dumps({"loggedIn": True, "authMethod": "claude.ai", "apiProvider": "firstParty",
                          "email": o["email"], "subscriptionType": o["subscriptionType"], "configDirectory": CFG}))
        return 0
    if argv[:2] == ["auth", "logout"]:
        if os.path.exists(CRED):
            os.remove(CRED)
        print("Successfully logged out.")
        return 0
    if argv and argv[0] == "-p":
        if os.environ.get("FAKE_CLAUDE_LOG"):
            with open(os.environ["FAKE_CLAUDE_LOG"], "a") as f:
                f.write(json.dumps(argv) + "\n")
        schema = argv[argv.index("--json-schema") + 1] if "--json-schema" in argv else ""
        if "checked_sources" in schema:
            return editor(sys.stdin.read())
        if '"suggested"' in schema:
            return topics(sys.stdin.read())
        print(json.dumps({"type": "result", "is_error": False, "structured_output": {"allowed": True, "reason": ""}}))
        return 0
    print(f"fake_claude: unknown command {argv}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
